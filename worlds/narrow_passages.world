<?xml version="1.0" ?>
<!--
  Narrow Passages world — 5 zigzag corridors (0.9 m interior width).
  Shortened length to prevent LiDAR feature-starvation (corridor problem).
-->
<sdf version="1.6">
  <world name="narrow_passages_world">

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.82 0.82 0.82 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         SHORTENED CORRIDOR BOUNDARIES
         Total width: x from -2.0 to +2.0 (4 meters total length)
         This guarantees the robot's 3.5m LiDAR ALWAYS sees a corner.
         ════════════════════════════════════════════════════════════════ -->

    <!-- Bottom boundary (y=-4.5) -->
    <model name="wall_bottom"><static>true</static><pose>0 -4.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>4.1 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.1 0.1 1.0</size></box></geometry>
          <material><ambient>0.40 0.38 0.35 1</ambient><diffuse>0.40 0.38 0.35 1</diffuse></material></visual>
      </link></model>

    <!-- Top boundary (y=-0.05) -->
    <model name="wall_top"><static>true</static><pose>0 -0.05 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>4.1 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.1 0.1 1.0</size></box></geometry>
          <material><ambient>0.40 0.38 0.35 1</ambient><diffuse>0.40 0.38 0.35 1</diffuse></material></visual>
      </link></model>

    <!-- West end wall (x=-2.0) -->
    <model name="wall_west"><static>true</static><pose>-2.0 -2.275 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 4.55 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 4.55 1.0</size></box></geometry>
          <material><ambient>0.40 0.38 0.35 1</ambient><diffuse>0.40 0.38 0.35 1</diffuse></material></visual>
      </link></model>

    <!-- East end wall (x=+2.0) -->
    <model name="wall_east"><static>true</static><pose>2.0 -2.275 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 4.55 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 4.55 1.0</size></box></geometry>
          <material><ambient>0.40 0.38 0.35 1</ambient><diffuse>0.40 0.38 0.35 1</diffuse></material></visual>
      </link></model>

    <!-- ── wall_A  y=-3.4  gap LEFT (x: -2.0 → -1.0)
         Creates C1 width: 1.0m -->
    <model name="wall_A"><static>true</static><pose>0.5 -3.4 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>3.0 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.1 1.0</size></box></geometry>
          <material><ambient>0.75 0.65 0.55 1</ambient><diffuse>0.75 0.65 0.55 1</diffuse></material></visual>
      </link></model>

    <!-- ── wall_B  y=-2.8  gap RIGHT (x: +1.0 → +2.0)
         Creates C2 width: 0.5m (Very Narrow) -->
    <model name="wall_B"><static>true</static><pose>-0.5 -2.8 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>3.0 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.1 1.0</size></box></geometry>
          <material><ambient>0.75 0.65 0.55 1</ambient><diffuse>0.75 0.65 0.55 1</diffuse></material></visual>
      </link></model>

    <!-- ── wall_C  y=-1.5  gap LEFT (x: -2.0 → -1.0)
         Creates C3 width: 1.2m (Wide) -->
    <model name="wall_C"><static>true</static><pose>0.5 -1.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>3.0 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.1 1.0</size></box></geometry>
          <material><ambient>0.75 0.65 0.55 1</ambient><diffuse>0.75 0.65 0.55 1</diffuse></material></visual>
      </link></model>

    <!-- ── wall_D  y=-0.75  gap RIGHT (x: +1.0 → +2.0)
         Creates C4 interior: 0.65m (navigable narrow) -->
    <model name="wall_D"><static>true</static><pose>-0.5 -0.75 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>3.0 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.1 1.0</size></box></geometry>
          <material><ambient>0.75 0.65 0.55 1</ambient><diffuse>0.75 0.65 0.55 1</diffuse></material></visual>
      </link></model>

  </world>
</sdf>
